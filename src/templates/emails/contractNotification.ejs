<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Your Purchase Contract</title>
  </head>
  <body style="font-family: Arial, sans-serif; line-height: 1.6; color: #333">
    <div
      style="
        max-width: 600px;
        margin: 0 auto;
        padding: 20px;
        border: 1px solid #ddd;
        border-radius: 5px;
      "
    >
      <h2 style="color: #0275d8">Your Purchase Contract is Ready</h2>
      <p>Hello <%= name %>,</p>
      <p>
        Thank you for your transaction on EV-Market. The electronic purchase
        contract for your transaction #<strong><%= transactionId %></strong> is
        now available.
      </p>
      <p>
        You can view or download your contract using the links below. We
        recommend keeping this document for your records.
      </p>
      <p style="text-align: center; margin: 25px 0">
        <a
          href="<%= viewUrl %>"
          style="
            display: inline-block;
            padding: 10px 20px;
            margin: 5px;
            background-color: #0275d8;
            color: #fff;
            text-decoration: none;
            border-radius: 5px;
          "
          >View Contract</a
        >
        <a
          href="<%= downloadUrl %>"
          style="
            display: inline-block;
            padding: 10px 20px;
            margin: 5px;
            background-color: #5cb85c;
            color: #fff;
            text-decoration: none;
            border-radius: 5px;
          "
          >Download PDF</a
        >
      </p>
      <p>Best regards,<br />The EV-Market Team</p>
    </div>
  </body>
</html>